#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/lib.sh"

require_cmd container

if ! machine_exists; then
    log "machine $DEVVM_NAME does not exist"
    exit 0
fi

printf "Delete machine '%s' and all of its persistent state? [y/N] " "$DEVVM_NAME"
IFS= read -r answer
case "$answer" in
    y|Y|yes|YES)
        container machine stop "$DEVVM_NAME" >/dev/null 2>&1 || true
        container machine rm "$DEVVM_NAME"
        ;;
    *)
        log "cancelled"
        ;;
esac
