#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/lib.sh"

require_cmd container

container machine ls

if machine_exists; then
    printf '\nMachine config:\n'
    container machine inspect "$DEVVM_NAME"
    printf '\nSSH service:\n'
    container machine run -n "$DEVVM_NAME" -- systemctl status ssh --no-pager || true
fi
