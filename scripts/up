#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/lib.sh"

require_cmd container
require_cmd grep

ensure_container_services
ensure_dns_domain

machine_exists || die "machine '$DEVVM_NAME' does not exist; run ./scripts/init"
log "reusing machine $DEVVM_NAME"
assert_home_mount_none
container machine run -n "$DEVVM_NAME" -- true >/dev/null
validate_ssh
print_connection_info
