#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/lib.sh"

require_cmd container
require_cmd ssh
require_cmd awk
require_cmd find

if ! container system status >/dev/null 2>&1; then
    log "starting Apple container services"
    container system start
fi

if ! container system dns ls -q 2>/dev/null | grep -Fqx "$DEVVM_DNS_DOMAIN"; then
    log "creating local DNS domain '$DEVVM_DNS_DOMAIN' (sudo required)"
    sudo container system dns create "$DEVVM_DNS_DOMAIN"
fi

if machine_exists; then
    log "reusing machine $DEVVM_NAME"
    assert_home_mount_none
    container machine run -n "$DEVVM_NAME" -- true >/dev/null
else
    log "building $DEVVM_IMAGE"
    container build -t "$DEVVM_IMAGE" "$REPO_ROOT"

    log "creating machine $DEVVM_NAME (home mount disabled)"
    container machine create \
        --name "$DEVVM_NAME" \
        --set-default \
        --cpus "$DEVVM_CPUS" \
        --memory "$DEVVM_MEMORY" \
        --home-mount none \
        "$DEVVM_IMAGE"
fi

[ -d "$HOME/.ssh" ] || die "$HOME/.ssh does not exist"

KEY_LIST=$(mktemp "${TMPDIR:-/tmp}/apple-devvm-keys.XXXXXX")
KEY_DATA=$(mktemp "${TMPDIR:-/tmp}/apple-devvm-authorized.XXXXXX")
trap 'rm -f "$KEY_LIST" "$KEY_DATA"' EXIT HUP INT TERM

find "$HOME/.ssh" -maxdepth 1 -type f -name '*.pub' -print | sort > "$KEY_LIST"
[ -s "$KEY_LIST" ] || die "no public keys found in $HOME/.ssh/*.pub"

: > "$KEY_DATA"
while IFS= read -r key; do
    cat "$key" >> "$KEY_DATA"
    printf '\n' >> "$KEY_DATA"
done < "$KEY_LIST"

# Remove blank lines and duplicate public-key lines.
awk 'NF && !seen[$0]++' "$KEY_DATA" > "$KEY_DATA.tmp"
mv "$KEY_DATA.tmp" "$KEY_DATA"

log "syncing host public keys into guest authorized_keys"
container machine run \
    -n "$DEVVM_NAME" \
    --root \
    -e "DEVVM_USER=$DEVVM_SSH_USER" \
    -i \
    -- /bin/sh -ceu '
        user=$DEVVM_USER
        home=$(getent passwd "$user" | cut -d: -f6)
        [ -n "$home" ] || { echo "guest user not found: $user" >&2; exit 1; }
        group=$(id -gn "$user")

        install -d -m 700 -o "$user" -g "$group" "$home/.ssh"
        cat > "$home/.ssh/authorized_keys"
        chown "$user:$group" "$home/.ssh/authorized_keys"
        chmod 600 "$home/.ssh/authorized_keys"
    ' < "$KEY_DATA"

log "checking sshd"
container machine run -n "$DEVVM_NAME" -- systemctl is-active --quiet ssh
container machine run -n "$DEVVM_NAME" -- /usr/sbin/sshd -T | grep -E \
    '^(pubkeyauthentication|authenticationmethods|passwordauthentication|kbdinteractiveauthentication|permitrootlogin) '

printf '\nReady.\n'
printf '  %s\n' "$SCRIPT_DIR/ssh"
printf '  ssh %s@%s.%s\n' "$DEVVM_SSH_USER" "$DEVVM_NAME" "$DEVVM_DNS_DOMAIN"
